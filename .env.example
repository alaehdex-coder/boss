# Copy to .env.local for `vercel dev`; set the same keys in Vercel → Project → Settings → Environment Variables.

# Signup storage (added automatically when you connect Upstash Redis from the Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional email alert for each new signup (https://resend.com)
RESEND_API_KEY=
SIGNUP_NOTIFY_TO=you@yourcompany.com
SIGNUP_NOTIFY_FROM=BOSS <signups@yourdomain.com>
